# Docker Compose runtime settings. Copy to .env and replace as required.
# The API is intentionally bound to loopback by default. Put Nginx/Caddy in
# front of it for HTTPS instead of exposing Rspamd or Uvicorn directly.
EMAIL_ANALYSIS_IMAGE=email-analysis:local
EMAIL_ANALYSIS_BIND_ADDRESS=127.0.0.1
EMAIL_ANALYSIS_PORT=3200
MAIL_ANALYZER_CORS_ORIGINS=https://mail.example.com
MAIL_ANALYZER_MAX_UPLOAD_BYTES=15728640
MAIL_ANALYZER_MAX_TRAINING_UPLOAD_BYTES=10485760
MAIL_ANALYZER_MIN_TRAINING_SAMPLES=10
RSPAMD_TIMEOUT_SECONDS=30
# `ext_urls` may be added only after approving the network behavior it enables.
RSPAMD_FLAGS=pass_all,groups,no_log

# Pin these in your organization when a specific release is approved.
RSPAMD_IMAGE=rspamd/rspamd:4.0
EMAIL_ANALYSIS_DATA_VOLUME=email_analysis_data
RSPAMD_DATA_VOLUME=email_analysis_rspamd_data
EMAIL_ANALYSIS_NETWORK=email_analysis_network
